# espos-p4-cockpit — project defaults (ESP32-P4 only for now).
# Mirrors espos/sdkconfig.defaults + espos/sdkconfig.defaults.esp32p4, plus
# the panel: 16 MB flash, HEX PSRAM, LVGL buffers, hosted WiFi/BLE on the C6.

# ---- Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="p4_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="p4_16mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- Chip / memory
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_FREERTOS_HZ=1000

# ---- Hosted WiFi over SDIO (ESP32-C6 on the Waveshare boards)
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000

# ---- Logging / HTTP server (espOS)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y
CONFIG_ESPOS_HTTPD_MAX_URI_HANDLERS=64
CONFIG_ESPOS_SK_RX_FRAME_MAX=65536

# ---- lwIP: the panel streams and serves layouts/screenshots
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=16

# ---- Core dump, OTA rollback, signed images (espOS)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# ---- LVGL runs on its own task with a big stack; C++ app
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- LVGL: configured by components/cockpit_hal/lv_conf.h (LV_CONF_PATH), not Kconfig
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# ---- esp-sr: on-device wake word "Hi ESP" (WakeNet 9) from the "model" partition
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# ---- Internal RAM at boot is the scarce resource on the P4 (RETENT_RAM ~100 KiB
# after .data/.bss; esp_hosted allocates ~130 KiB before app_main and the main
# task must still find a home). Keep hosted's task stacks in PSRAM and a few
# IDF hot paths in flash instead of IRAM. Symptom otherwise:
# "assert failed: esp_startup_start_app app_startup.c:83 (res == pdTRUE)".
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_WIFI_RMT_IRAM_OPT=n
CONFIG_WIFI_RMT_RX_IRAM_OPT=n
CONFIG_WIFI_RMT_EXTRA_IRAM_OPT=n

# ---- N2K gateway: TWAI (legacy driver API kept from 1.x; migration to esp_twai pending)
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_TWAI_ERRATA_FIX_LISTEN_ONLY_DOM=y

# ---- MIPI-DSI refresh must survive a disabled cache.
# The DPI stream is fed by a DMA ISR. With the ISR in flash (the default),
# every cache-disabling flash operation — an NVS commit from the layout
# store, a core-dump write, an OTA erase — stalls it, the DPI stream
# underruns and the whole panel blanks for an instant. Symptom: periodic
# full-screen flicker on any layout.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y

# ---- esp_hosted SDIO: conservative profile.
# The high-throughput tuning here was inherited from 1.x, which streamed
# MJPEG frames off the panel. 2.x does not: its heaviest traffic is an
# occasional ~30 KB screenshot, so the aggressive settings buy nothing
# and are prime suspects for the transport wedging
# (espressif/esp-hosted-mcu#184) — the panel goes unreachable while
# H_SDIO_DRV spams "task still writing Rx data to queue!", i.e. an Rx
# queue overrun.
#
# NOT streaming mode: tested and it does not boot. The C6 slave firmware
# is fixed in streaming mode and the host must match, or the transport
# asserts at startup:
#   "SDIO mode mismatch: slave is in streaming mode, but host is in
#    packet mode. Aborting." (transport_drv.c:892)
# So RX_STREAMING_MODE stays on; only the block-ack window below is
# available to tune from the host side.
# Match the C6 slave's own default block-ack window instead of forcing 16.
# With hosted WiFi the radio is remote, so the knob that reaches it is
# WIFI_RMT_* (esp_wifi_remote), not the local ESP_WIFI_* one.
# Internal RAM is the scarce resource on this board: total heap reads ~30 MB
# but that is almost all PSRAM, and the health watchdog reboots below an 8 KB
# largest-free internal block. In practice iram_big settled around 10 KB —
# roughly 2 KB of headroom, so any request needing a contiguous internal block
# could tip it.
#
# IDF's default sends every malloc() under 16 KB to internal RAM first. Lower
# it so ordinary allocations — including the 1-4 KB JsonDocument/string churn
# of every SK delta — prefer PSRAM and leave internal RAM to the DMA users
# (hosted transport, I2S, DSI). Anything that genuinely needs internal memory
# asks for it with MALLOC_CAP_INTERNAL and is unaffected, and the allocator
# still falls back to internal when PSRAM is full (Kconfig.spiram.common).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# Enlarge the internal reserve (default 32 KB) that is prioritized for
# MALLOC_CAP_INTERNAL/DMA requests (hosted transport buffers, I2S/DSI DMA,
# task stacks): ordinary allocation pressure spills to PSRAM 64 KB earlier
# instead of starving the radio's DMA pool. Plain malloc() can still reach
# the reserve as a last resort once everything else is exhausted — this is
# a priority tier, not a hard floor.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Keep the hosted transport mempool — the transport's large DMA buffer
# pool — in PSRAM: left internal, sustained inbound TCP (the stream
# widget) exhausts internal RAM until the SDIO link to the C6 wedges. Only valid with 64-byte L2
# cache lines: the 1600-byte transport stride is not 128-aligned, and
# 128-byte lines make the SDIO driver reject PSRAM buffers
# (esp-hosted-mcu#219). The line size is pinned so the prerequisite is
# enforced, not just documented — raising the L2 cache size (256 KB forces
# 128-byte lines) would otherwise flip it silently and wedge the
# transport. Guidance and measurements: espos/docs/wifi.md (espOS #33).
CONFIG_CACHE_L2_CACHE_LINE_64B=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

CONFIG_WIFI_RMT_RX_BA_WIN=6
